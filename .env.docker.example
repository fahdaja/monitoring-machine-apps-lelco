# Salin file ini menjadi .env.docker, lalu isi minimal APP_KEY + 2 password.
#
#   copy .env.docker.example .env.docker       (PowerShell: Copy-Item)
#   docker compose run --rm --no-deps app php artisan key:generate --show
#   -> tempel hasilnya ke APP_KEY di bawah.
#
# .env.docker tidak ikut ke image (.dockerignore menyaring .env.*) dan tidak
# boleh di-commit: isinya kredensial.
#
# File ini dibaca DUA service: app (variabel DB_*/APP_*) dan db (variabel
# MYSQL_*). Nilai MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE harus sama persis
# dengan DB_USERNAME/DB_PASSWORD/DB_DATABASE, kalau tidak app gagal login.
# Jangan pakai karakter # di dalam password (env_file memaknainya sebagai
# komentar) dan hindari tanda kutip.

# ---------------------------------------------------------------- app (Laravel)
APP_NAME=Lelco Form
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# stderr supaya log masuk ke `docker compose logs -f app`, bukan ke file di
# dalam container.
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
# "db" = nama service di docker-compose.yml. Untuk MySQL di luar container,
# ganti host.docker.internal (lihat catatan di docker-compose.yml).
DB_HOST=db
DB_PORT=3306
DB_DATABASE=MonitoringMachineDbFahd
DB_USERNAME=lelco
DB_PASSWORD=ganti-password-ini

# Session, cache dan (calon) queue tetap di database seperti .env dev lu:
# tabelnya dibuat migration (sessions, cache, cache_locks, jobs).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log
MAIL_MAILER=log

REDIS_HOST=127.0.0.1

# ------------------------------------------------------------------- container db
MYSQL_DATABASE=LelcoFormDb
MYSQL_USER=lelco
MYSQL_PASSWORD=ganti-password-ini
MYSQL_ROOT_PASSWORD=ganti-root-password-ini

# =========================================================================== catatan
# 1. APP_KEY kosong = entrypoint membuat key sementara setiap container start
#    dan mencetaknya di log. Efeknya: semua cookie session & encrypted cookie
#    (appearance/sidebar_state) tidak berlaku lagi tiap kali container dibuat
#    ulang, jadi user logout massal. Simpan satu key tetap di sini.
#
# 2. APP_ENV=production mengaktifkan Password::defaults() di AppServiceProvider
#    (min 12 + ->uncompromised). uncompromised() memanggil
#    api.pwnedpasswords.com saat user dibuat/reset password. Kalau jaringan
#    kantor memblokir situs itu dan form user gagal submit, pakai
#    APP_ENV=local (APP_DEBUG=true jangan di produksi).
#
# 3. APP_URL dipakai Inertia & QR/link absolut. Kalau diakses dari HP di
#    jaringan kantor, isi alamat host mesin ini, misalnya
#    APP_URL=http://192.168.1.20:8000  (port tetap yang dipetakan compose).
